{
  "name": "ahuverify-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:types": "json2ts -i src/types/unit-config.schema.json -o src/types/config.ts --no-additionalProperties --bannerComment \"/* Generated from engine/ahuverify/schema.py via unit-config.schema.json. Do not edit; run npm run gen:types. */\"",
    "check:tokens": "node --experimental-strip-types scripts/mockup-assets.mjs --check",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@clerk/react": "6.17.5",
    "@tanstack/react-table": "9.2.4",
    "@xyflow/react": "12.12.0",
    "d3-scale": "4.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "27.4.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
