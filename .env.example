# Names of settings only, never values. Copy to .env (git-ignored) and fill in.

# --- API (api/) ---
ENV=                       # development | production
AUTH_MODE=                 # clerk (default) | dev  (dev skips sign-in; refused when ENV=production)
CLERK_JWKS_URL=            # https://<your-clerk-frontend-api>/.well-known/jwks.json
CLERK_ISSUER=              # https://<your-clerk-frontend-api>
CLERK_AUTHORIZED_PARTIES=  # comma-separated web origins, e.g. https://app.example.com
DATABASE_URL=              # postgresql://… (Neon) — defaults to a local SQLite file
CORS_ORIGINS=              # comma-separated web origins allowed to call the API

# --- Web (web/) ---
VITE_API_URL=              # e.g. http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=
VITE_AUTH_MODE=            # clerk (default) | dev
